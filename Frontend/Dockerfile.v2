# ── Frontend: nginx-alpine (smallest possible image ~10MB) ──
FROM node:20-alpine AS build

WORKDIR /app
COPY Frontend/package.json Frontend/package-lock.json* ./
RUN npm ci --production=false
COPY Frontend/ .
RUN npm run build

FROM nginx:1.27-alpine

LABEL maintainer="Satellite Telemetry Anomaly Detection Team"
LABEL version="2.1"
LABEL description="Static frontend for STAD-AI (optimized)"

# Non-root: nginx-alpine supports running as nginx user on port 8080
RUN sed -i 's/listen\s*80;/listen 8080;/' /etc/nginx/conf.d/default.conf && \
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx/conf.d && \
    touch /run/nginx.pid && chown nginx:nginx /run/nginx.pid

COPY --from=build /app/dist /usr/share/nginx/html
COPY Frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Fix port to 8080 for non-root
RUN sed -i 's/listen 80;/listen 8080;/' /etc/nginx/conf.d/default.conf && \
    chown nginx:nginx /etc/nginx/conf.d/default.conf

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --retries=5 \
    CMD wget -q --spider http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
