# ── Legacy Backend Dockerfile (v1) ──
# DEPRECATED: Use Backend/Dockerfile.v2 with docker-compose.v2.yml
# Kept for backward compatibility with docker-compose.split.yml
FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

LABEL version="1.1-legacy"
LABEL description="Backend AI Inference Engine (legacy — use Dockerfile.v2)"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-dev python3.11-distutils curl && \
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -r -s /sbin/nologin appuser && \
    mkdir -p data models results checkpoints && \
    chown -R appuser:appuser /app

COPY --chown=appuser:appuser requirements.txt ./
USER appuser
RUN pip install --no-cache-dir --user -r requirements.txt
ENV PATH="/home/appuser/.local/bin:${PATH}"

COPY --chown=appuser:appuser Backend/ .

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=3)" || exit 1

CMD ["python", "serve.py"]