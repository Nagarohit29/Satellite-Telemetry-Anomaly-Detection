FROM python:3.11-slim-bookworm AS base

LABEL maintainer="Satellite Telemetry Anomaly Detection Team"
LABEL version="2.1"
LABEL description="Backend API for STAD-AI (optimized)"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    TRITON_URL=http://triton:8000 \
    TRITON_MODEL_NAME=tranad

WORKDIR /app

COPY docker/wheels /tmp/wheels
COPY docker/runtime-requirements.txt /tmp/runtime-requirements.txt
RUN python -m pip install --no-index --find-links /tmp/wheels -r /tmp/runtime-requirements.txt && \
    rm -rf /tmp/wheels /tmp/runtime-requirements.txt && \
    find /usr/local/lib/python3.11 -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null; \
    find /usr/local/lib/python3.11 -name '*.pyc' -delete 2>/dev/null; true

COPY Backend/ ./Backend/

# Non-root user
RUN useradd -r -s /sbin/nologin appuser && \
    chown -R appuser:appuser /app
USER appuser

WORKDIR /app/Backend

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=3)" || exit 1

CMD ["python", "serve.py"]
