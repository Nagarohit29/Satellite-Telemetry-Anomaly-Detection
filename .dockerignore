# Git
.git
.gitignore
.github

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
*.egg-info/

# Environment files — NEVER bake real API keys into images
.env
Middleware/.env
config/.env
secrets/

# Node.js (Frontend built in multi-stage, exclude source)
node_modules/
npm-debug.log*
yarn-debug.log*
Frontend/node_modules/
# Do not ignore Frontend/src, public, package.json etc. since we build inside Docker on HF and keep branches in sync
# Frontend/src/
# Frontend/public/
# Frontend/package*.json
# Frontend/vite.config.js
# Frontend/index.html
# Frontend/.eslintrc*
# Frontend/README*
!Frontend/dist/
!Frontend/dist/**
!Frontend/nginx.monolith.conf
!Frontend/nginx.conf
!Frontend/nginx.hf.conf
!Frontend/Dockerfile*

# Build artifacts
dist/
build/
.next/
out/
!Frontend/dist/
!Frontend/dist/**

# Data — exclude everything except needed replay data
Backend/data/*
!Backend/data/SMAP_MSL/
!Backend/data/SMAP_MSL/**
Backend/data/SMAP_MSL/recordings/
Backend/models/
Backend/results/
Backend/processed/
Backend/plots/
Backend/checkpoints/*
!Backend/checkpoints/TranAD_SMAP/
!Backend/checkpoints/TranAD_SMAP/model.ckpt

# Notebooks, scratch, tests (not needed in prod images)
notebooks/
scratch/
Backend/scratch/
Backend/tests/
Middleware/tests/
*.ipynb

# OS files
.DS_Store
Thumbs.db

# Docs and configs not needed in image
docs/
.codex_tmp/
.hermes/
.agents/
*.md
!README.md

# Docker meta (not needed inside context for compose)
docker-compose*
.dockerignore
requirements.lock
requirements.txt
